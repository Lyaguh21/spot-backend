generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  name     String
  email    String @unique

  avatarUrl  String?
  bio        String?
  visibility Visibility @default(PUBLIC)

  role UserRole @default(USER)

  coupleMembers CoupleMember[]

  // подписки на пользователей
  followingUsers UserSubscription[] @relation("UserFollowing")

  // подписки на пары
  followingCouples CoupleSubscription[] @relation("UserFollowingCouples")

  // подписчики (только пользователи)
  followers UserSubscription[] @relation("UserFollowers")

  visits Visit[] @relation("UserVisits")

  passwordHash       String
  hashedRefreshToken String? // может быть null (если не залогинен)
  tokenVersion       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)

  bugReports BugReport[]
}

enum UserRole {
  USER
  ADMIN
}

model UserSubscription {
  id String @id @default(uuid())

  followerId   String
  targetUserId String

  follower User @relation("UserFollowing", fields: [followerId], references: [id])

  targetUser User @relation("UserFollowers", fields: [targetUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([followerId, targetUserId])
}

model Couple {
  id String @id @default(uuid())

  bio        String?
  isPrivate  Boolean @default(false)
  inviteCode String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CoupleMember[]

  visits Visit[] @relation("CoupleVisits")

  followers CoupleSubscription[]
}

model CoupleSubscription {
  id String @id @default(uuid())

  followerId     String
  targetCoupleId String

  follower User @relation("UserFollowingCouples", fields: [followerId], references: [id])

  targetCouple Couple @relation(fields: [targetCoupleId], references: [id])

  createdAt DateTime @default(now())

  @@unique([followerId, targetCoupleId])
}

model CoupleMember {
  id String @id @default(uuid())

  coupleId String
  userId   String

  couple Couple @relation(fields: [coupleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  role CoupleRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([coupleId, userId])
}

enum CoupleRole {
  MEMBER
  ADMIN
}

enum OwnerType {
  USER
  COUPLE
}

enum VisitStatus {
  VISITED
  PLANNED
}

model Place {
  id String @id @default(uuid())

  title String

  lat Float
  lng Float

  address String?

  websiteUrl String?

  externalId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
}

model Visit {
  id String @id @default(uuid())

  placeId String
  place   Place  @relation(fields: [placeId], references: [id])

  ownerType OwnerType @default(USER)

  userId String?
  user   User?   @relation("UserVisits", fields: [userId], references: [id])

  coupleId String?
  couple   Couple? @relation("CoupleVisits", fields: [coupleId], references: [id])

  title String

  description String?

  ratings Json @default("[]")

  isFavorite Boolean @default(false)

  photos String[] @default([])

  icon String @default("")

  color String @default("")

  status VisitStatus @default(VISITED)

  visitDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Visibility {
  PRIVATE
  PUBLIC
}

model BugReport {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  title       String
  description String

  type String

  photos String[] @default([])

  createdAt DateTime @default(now())
}
