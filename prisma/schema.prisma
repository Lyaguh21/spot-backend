generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  name     String
  email    String @unique

  avatarUrl  String?
  bio        String?
  visibility Visibility @default(PUBLIC)

  visits Visit[]

  passwordHash       String
  hashedRefreshToken String? // может быть null (если не залогинен)
  tokenVersion       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)
}

model Place {
  id String @id @default(uuid())

  title String

  lat Float
  lng Float

  address String?

  websiteUrl String?

  externalId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
}

model Visit {
  id String @id @default(uuid())

  placeId String
  place   Place  @relation(fields: [placeId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  description String?

  rating Int

  isFavorite Boolean @default(false)

  visitDate DateTime

  visibility Visibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Visibility {
  PRIVATE
  PUBLIC
}
