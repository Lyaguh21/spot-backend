generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       String @id @default(uuid())
  username String @unique
  name     String
  email    String @unique

  avatarUrl  String?
  bio        String?
  visibility Visibility @default(PUBLIC)

  coupleMembers CoupleMember[]

  followers UserSubscription[] @relation("UserFollowing")

  following UserSubscription[] @relation("UserFollowers")

  visits Visit[] @relation("UserVisits")

  passwordHash       String
  hashedRefreshToken String? // может быть null (если не залогинен)
  tokenVersion       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isDeleted Boolean @default(false)
}

model UserSubscription {
  id String @id @default(uuid())

  followerId   String
  targetUserId String

  follower User @relation("UserFollowers", fields: [followerId], references: [id])

  targetUser User @relation("UserFollowing", fields: [targetUserId], references: [id])

  createdAt DateTime @default(now())

  @@unique([followerId, targetUserId])
}

model Couple {
  id String @id @default(uuid())

  description String?
  inviteCode  String  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members CoupleMember[]

  visits Visit[] @relation("CoupleVisits")
}

model CoupleMember {
  id String @id @default(uuid())

  coupleId String
  userId   String

  couple Couple @relation(fields: [coupleId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  role CoupleRole @default(MEMBER)

  createdAt DateTime @default(now())

  @@unique([coupleId, userId])
}

enum CoupleRole {
  MEMBER
  ADMIN
}

enum OwnerType {
  USER
  COUPLE
}

model Place {
  id String @id @default(uuid())

  title String

  lat Float
  lng Float

  address String?

  websiteUrl String?

  externalId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  visits Visit[]
}

model Visit {
  id String @id @default(uuid())

  placeId String
  place   Place  @relation(fields: [placeId], references: [id])

  ownerType OwnerType @default(USER)

  userId String?
  user   User?   @relation("UserVisits", fields: [userId], references: [id])

  coupleId String?
  couple   Couple? @relation("CoupleVisits", fields: [coupleId], references: [id])

  description String?

  rating Int?

  isFavorite Boolean @default(false)

  visitDate DateTime

  visibility Visibility @default(PUBLIC)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Visibility {
  PRIVATE
  PUBLIC
}
